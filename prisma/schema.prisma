generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Papéis dos usuários no sistema
enum Role {
  ADMIN
  MANAGER // Coordenadores/Secretaria
  TEACHER // Professores
  MONITOR // Monitores de risco de evasão
}

// Usuários (Gestores, Professores, Monitores)
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(TEACHER)
  
  telefone  String?
  avatar    String? // Imagem base64
  
  escolaId  String?
  escola    Escola?  @relation(fields: [escolaId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

// Turmas
model Class {
  id         String       @id @default(uuid())
  name       String       // Ex: "1º Ano A"
  year       Int          // Ex: 2026
  course     String       // Ex: "Ensino Médio"
  shift      String       // Ex: "Manhã"
  
  escolaId   String?
  escola     Escola?      @relation(fields: [escolaId], references: [id])

  students    Student[]
  attendances Attendance[]
  createdAt   DateTime     @default(now())

  @@map("turmas")
}

// Alunos
model Student {
  id                String       @id @default(uuid())
  registration      String       @unique // Matrícula
  name              String
  email             String       @unique
  birthDate         DateTime?    
  biometricDataUrl  String?      
  biometricEncoding String?      
  
  escolaId          String?
  escola            Escola?      @relation(fields: [escolaId], references: [id])

  classId           String
  class             Class        @relation(fields: [classId], references: [id])
  
  attendances       Attendance[]
  alerts            Alert[]
  grades            Grade[]
  incidents         Incident[]
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("alunos")
}

// Status da chamada
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED // Falta justificada
}

// Registro de Frequência
model Attendance {
  id        String           @id @default(uuid())
  date      DateTime         @default(now())
  status    AttendanceStatus
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  classId   String
  class     Class            @relation(fields: [classId], references: [id])

  @@unique([studentId, date]) 
  @@map("chamadas")
}

enum AlertStatus {
  PENDING
  RESOLVED
}

// Alertas de Risco de Evasão
model Alert {
  id         String      @id @default(uuid())
  reason     String      
  status     AlertStatus @default(PENDING)
  studentId  String
  student    Student     @relation(fields: [studentId], references: [id])
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  @@map("alertas")
}

// Avaliações
model Grade {
  id        String   @id @default(uuid())
  subject   String   
  value     Float    
  date      DateTime @default(now())
  
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("notas")
}

// Ocorrências (Para o painel do Monitor e Diário)
model Incident {
  id          String   @id @default(uuid())
  type        String   
  description String   
  date        DateTime @default(now())
  
  studentId   String?  
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  escolaId    String?
  escola      Escola?  @relation(fields: [escolaId], references: [id])

  @@map("ocorrencias")
}

// Calendário & Eventos Escolares
model Event {
  id              String   @id @default(uuid())
  title           String   
  description     String?  // <-- Adicionado
  color           String?  // <-- Adicionado
  startDate       DateTime 
  endDate         DateTime 
  type            String   
  excusesAbsence  Boolean  @default(false) 
  audience        String   
  
  escolaId        String?
  escola          Escola?  @relation(fields: [escolaId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("eventos")
}

// Escolas (Tenant Principal)
model Escola {
  id          String   @id @default(uuid())
  nome        String
  municipio   String
  rede        String
  status      String   @default("Pendente")
  
  inep        String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  uf          String?
  telefone    String?
  
  users       User[]
  classes     Class[]
  students    Student[]
  events      Event[]     
  incidents   Incident[]  
  
  createdAt   DateTime @default(now())

  @@map("escolas")
}

// Chamados (Central de Suporte)
model Chamado {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String
  escola      String?
  solicitante String
  categoria   String
  responsavel String?
  prioridade  String   @default("Normal")
  status      String   @default("Aberto")
  avaliacao   Int?

  mensagens    Json      @default("[]")
  historico    Json      @default("[]")
  notificacoes Json      @default("[]")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("chamados")
}

// Comunicados (Painel Administrativo)
model Comunicado {
  id          String    @id @default(uuid())
  titulo      String
  mensagem    String
  tipo        String    @default("Informativo")
  publico     String    @default("Todas as escolas")
  escolas     String[]  
  status      String    @default("Rascunho")
  inicio      DateTime?
  fim         DateTime?
  criadoEm    DateTime  @default(now())
  alteradoEm  DateTime  @updatedAt
  publicadoEm DateTime?

  @@map("comunicados")
}

// Auditoria (Painel Administrativo)
model Auditoria {
  id          String   @id @default(uuid())
  tipo        String   
  titulo      String   
  descricao   String?  
  entidade    String?  
  responsavel String   @default("Sistema")
  criadoEm    DateTime @default(now())

  @@map("auditoria")
}